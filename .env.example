DJANGO_SECRET_KEY=changeme-only-for-dev
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,ospreydev.phalkon.io
POSTGRES_DB=osprey
POSTGRES_USER=osprey
POSTGRES_PASSWORD=osprey
DATABASE_URL=postgres://osprey:osprey@db:5432/osprey
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://ospreydev.phalkon.io
ORCID_USE_SANDBOX=0
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ZENODO_USE_SANDBOX=1
ZENODO_ACCESS_TOKEN=
ZENODO_DEFAULT_COMMUNITY=

# Email transport (phase 1 of notifications). Provider-agnostic: the
# OSPREY backend delegates to EMAIL_DELIVERY_BACKEND, which can be any
# Django email backend (anymail ships one per provider; plain SMTP works
# too). Provider credentials are ANYMAIL_*-prefixed env vars and live
# ONLY here, never in the database. Switching providers is an env change
# plus possibly a pip extra (e.g. django-anymail[amazon-ses]). The
# non-secret settings (on/off switch, from address, test recipient) are
# managed in the admin panel under Notifications -> Email settings.
EMAIL_DELIVERY_BACKEND=anymail.backends.mailjet.EmailBackend
ANYMAIL_MAILJET_API_KEY=
ANYMAIL_MAILJET_SECRET_KEY=
DEFAULT_FROM_EMAIL=OSPREY <notify@osprey.phalkon.io>
# Email only actually sends where ANYMAIL_* keys are present; without
# them all mail (including the notifier loop's) goes to the console/log.
# Dev runs the notifier loop automatically via docker-compose.override.

# Optional. Raises the GitHub API rate limit for the license audit of linked repositories.
GITHUB_API_TOKEN=
# Optional. Contact address sent in the User-Agent to external APIs.
EXTERNAL_API_MAILTO=

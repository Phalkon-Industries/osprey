DJANGO_SECRET_KEY=changeme-only-for-dev
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,ospreydev.phalkon.io
POSTGRES_DB=osprey
POSTGRES_USER=osprey
POSTGRES_PASSWORD=osprey
DATABASE_URL=postgres://osprey:osprey@db:5432/osprey
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://ospreydev.phalkon.io
ORCID_USE_SANDBOX=0
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ZENODO_USE_SANDBOX=1
ZENODO_ACCESS_TOKEN=
ZENODO_DEFAULT_COMMUNITY=

# Email transport (phase 1 of notifications). Normally configured in the
# admin panel (Notifications -> Email settings); these seed that row on
# first run and act as fallbacks while its fields are blank.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
DEFAULT_FROM_EMAIL=OSPREY <notify@osprey.phalkon.io>
